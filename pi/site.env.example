# Site configuration for the Pi services — the env-var mirror of
# js/site-config.js. Copy to /etc/kanp/site.env and edit when pointing the
# tracker at a different airport; every service reads it via EnvironmentFile.
# Anything unset falls back to the defaults baked into pi/*.py (KANP values).

# --- collector.py ---
KANP_LAT=38.9422
KANP_LON=-76.5684
KANP_RADIUS_NM=60
# "airplanes" = public ADS-B API feeds; or a local receiver URL, e.g.
# http://127.0.0.1/skyaware/data/aircraft.json
#KANP_SOURCE=airplanes
#KANP_POLL_SECONDS=3
# Tight second poll of the pattern area between wide polls (public feeds
# only): 2 near + 1 wide per 3 s keeps to the feeds' 1 req/s. 0 disables.
#KANP_NEAR_RADIUS_NM=5
#KANP_NEAR_POLL_SECONDS=1
# Per-request timeouts (s). A 5 nm answer slower than this is skipped for the
# next feed — the old 20 s wait stalled every poll behind one slow feed.
#KANP_NEAR_TIMEOUT_S=3
#KANP_WIDE_TIMEOUT_S=10
# Leave a feed alone this long after it answers 429; doubles per further 429
# up to the max, resets after a success.
#KANP_FEED_COOLDOWN_S=3
#KANP_FEED_COOLDOWN_MAX_S=20
# Feed URL templates ({lat} {lon} {r}), comma-separated, tried in order — one
# list per poll. adsb.lol rate-limits us, so the near poll spends that budget
# (its low-level coverage holds the pattern) and the wide poll leads with adsb.fi.
#KANP_FEEDS_NEAR=https://api.adsb.lol/v2/point/{lat}/{lon}/{r},https://api.airplanes.live/v2/point/{lat}/{lon}/{r},https://opendata.adsb.fi/api/v2/lat/{lat}/lon/{lon}/dist/{r}
#KANP_FEEDS_WIDE=https://opendata.adsb.fi/api/v2/lat/{lat}/lon/{lon}/dist/{r},https://api.airplanes.live/v2/point/{lat}/{lon}/{r},https://api.adsb.lol/v2/point/{lat}/{lon}/{r}
#KANP_RETENTION_DAYS=365
#KANP_MAX_DB_MB=8000

# --- server.py ---
#KANP_PORT=8787

# --- exporter.py ---
#KANP_EXPORT_PUSH=1
#KANP_SIMPLIFY_NM=0.03
# Tolerance inside the near-poll ring (KANP_NEAR_RADIUS_NM). 0 publishes
# every fix there, so the 1 s sampling reaches the map.
#KANP_SIMPLIFY_NEAR_NM=0

# --- publisher git housekeeping (exporter.py, gitutil.py) ---
# The exporter keeps its branch at one amended commit, which orphans the
# previous commit's blobs locally every run. Prune/repack this often
# (seconds); lower it if the clone still grows between runs, raise it to cut
# SD-card writes.
#KANP_GC_INTERVAL_S=21600

# --- atc.py (LiveATC recorder + whisper transcripts) ---
# Feeds: semicolon list of  mount|label|frequency  (mount = LiveATC stream
# name, e.g. https://d.liveatc.net/kbwi_es_app_124550). Defaults baked into
# atc.py are the three Potomac feeds around KANP.
#KANP_ATC_FEEDS=kbwi_es_app_124550|Potomac Approach GRACO|124.550;kbwi_es_twr|Baltimore Tower|119.400;kbwi_es_final|Potomac BWI Final|119.0/119.7
#KANP_ATC_DIR=/var/lib/kanp/atc
#KANP_ATC_WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
#KANP_ATC_WHISPER_MODEL=/opt/whisper.cpp/models/ggml-base.en.bin
#KANP_ATC_WHISPER_THREADS=3
#KANP_ATC_RETENTION_DAYS=14
# Squelch: raise OPEN_RMS if noise triggers recordings, lower if it clips
# quiet transmissions.
#KANP_ATC_OPEN_RMS=700
#KANP_ATC_CLOSE_RMS=400
